# ─── Garagem do MEEC — Configuração ─────────────────────────────
# Copie este arquivo para .env e ajuste os valores

# Porta do servidor (Railway define automaticamente via PORT)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# ─── Banco de Dados ──────────────────────────────────────────────
# Se DATABASE_URL estiver definida, usa PostgreSQL (produção)
# Caso contrário, usa SQLite local (desenvolvimento)
#DATABASE_URL=postgresql://user:password@host:5432/garagem

# Caminho para o arquivo SQLite (apenas quando DATABASE_URL não está definida)
DB_PATH=./data/garagem.db

# ─── Autenticação ────────────────────────────────────────────────
# Senha secreta para as sessões (mude para algo seguro!)
SESSION_SECRET=garagem-do-meec-dev-secret

# Chave secreta para JWT tokens (mude para algo seguro em produção!)
JWT_SECRET=your-jwt-secret-key-change-in-production

# Credenciais do admin (criado automaticamente na primeira execução)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Pablo Jhonatan
ADMIN_EMAIL=admin@garagem.com.br

# Chave secreta para criar novos usuários via /api/register
REGISTER_SECRET=meec-admin-2026

# ─── WhatsApp Configuration ──────────────────────────────────────
# Ativar/desativar notificações WhatsApp
WHATSAPP_ENABLED=true

# Número do proprietário para receber notificações (formato internacional)
WHATSAPP_OWNER_NUMBER=5561981257477

# Para integração com Twilio WhatsApp (descomente e configure se quiser usar)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Google OAuth Configuration ──────────────────────────────────
# Credenciais do Google Cloud Console para login social
# Como criar:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie um projeto → APIs & Services → Credentials
#   3. Configure OAuth consent screen (External)
#   4. Crie OAuth Client ID (Web application)
#   5. Adicione redirect URIs:
#      - http://localhost:3000/api/auth/google/callback
#      - https://seudominio.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL base da aplicação (usada para callbacks de OAuth)
BASE_URL=http://localhost:3000

# URL do frontend (para redirecionamento após OAuth)
CLIENT_URL=http://localhost:3000

# ─── CRM Integration ──────────────────────────────────────────────
# URL do novo CRM (React) para onde redirecionar os links
CRM_URL=http://localhost:5000
